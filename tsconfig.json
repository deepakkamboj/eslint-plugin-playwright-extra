{
  "compileOnSave": false,
  "compilerOptions": {
    "sourceMap": false,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "alwaysStrict": true,
    "strictBindCallApply": true,
    "strictFunctionTypes": true,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "noUnusedParameters": true,
    "noUnusedLocals": true,
    "experimentalDecorators": true,
    "declaration": false,
    "target": "es5",
    "module": "commonjs",
    "outDir": "dist",
    "typeRoots": ["node_modules/@types"],
    "lib": ["es2017", "dom"],
    "baseUrl": "."
  },
  "include": ["rules/**/*", "helpers/**/*", "config/**/*"],
  "exclude": ["node_modules", "dist", "sandbox.ts", "**/*.spec.ts"]
}
