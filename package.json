{
  "name": "eslint-plugin-playwright-extra",
  "version": "1.0.0",
  "description": "ESLint rules for Playwright tests.",
  "main": "dist/index.js",
  "rulesDirectory": [
    "rules"
  ],
  "scripts": {
    "dev": "npm run build && tslint --project tsconfig.dev.json",
    "test": "npm run build && jest",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/jest": "22.2.2",
    "@types/node": "10.12.21",
    "jest": "23.6.0",
    "ts-jest": "23.10.5",
    "tslint": "^5.12.1",
    "typescript": "^3.3.1"
  },
  "jest": {
    "testMatch": [
      "<rootDir>/rules/**/?(*.)spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testPathIgnorePatterns": [
      "<rootDir>/node_modules/",
      "<rootDir>/dist/"
    ],
    "setupFiles": [
      "<rootDir>/config/jest/expect.js"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  }
}
