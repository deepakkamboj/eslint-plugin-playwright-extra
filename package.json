{
  "name": "eslint-plugin-playwright-extra",
  "version": "1.0.0",
  "description": "ESLint rules for Playwright tests.",
  "main": "dist/index.js",
  "rulesDirectory": [
    "rules"
  ],
  "scripts": {
    "dev": "npm run build && tslint --project tsconfig.dev.json",
    "test": "jest",
    "build": "tsc"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.24",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "tslint": "^6.1.3",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/rules/"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/config/jest/expect.js"
    ],
    "testMatch": [
      "**/*.spec.ts"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.json"
        }
      ]
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "moduleFileExtensions": [
      "ts",
      "js"
    ]
  }
}
